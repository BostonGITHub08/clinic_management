<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_appointment_list" model="ir.ui.view">
        <field name="name">clinic.appointment.list</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments" decoration-muted="state in ('cancelled', 'no_show')" decoration-bf="priority == '1'">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="appointment_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="department_id" optional="show"/>
                <field name="appointment_type" optional="show"/>
                <field name="consultation_fee" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="invoice_payment_state" widget="badge" optional="hide" groups="account.group_account_invoice"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state in ('cancelled', 'no_show')"
                       decoration-info="state in ('confirmed', 'checked_in')" decoration-warning="state == 'in_consultation'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_appointment_form" model="ir.ui.view">
        <field name="name">clinic.appointment.form</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check In" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_start_consultation" type="object" string="Start Consultation" class="btn-primary"
                            invisible="state != 'checked_in'" groups="esl_clinic_management.group_clinic_doctor"/>
                    <button name="action_done" type="object" string="Complete" class="btn-primary"
                            invisible="state != 'in_consultation'" groups="esl_clinic_management.group_clinic_doctor"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            invisible="state not in ('checked_in', 'in_consultation', 'done') or invoice_id or not consultation_fee"
                            groups="account.group_account_invoice"/>
                    <button name="action_no_show" type="object" string="No Show" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed', 'checked_in')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('cancelled', 'no_show')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,in_consultation,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_consultation" type="object" class="oe_stat_button" icon="fa-stethoscope"
                                invisible="not consultation_id" string="Consultation"/>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not invoice_id" groups="account.group_account_invoice">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoice</span>
                                <span class="o_stat_value"><field name="invoice_payment_state"/></span>
                            </div>
                        </button>
                    </div>
                    <field name="consultation_id" invisible="1"/>
                    <field name="invoice_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1 class="d-flex gap-2"><field name="priority" widget="priority"/><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient">
                            <field name="patient_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="patient_phone" widget="phone"/>
                            <field name="patient_age"/>
                            <field name="appointment_type" readonly="state not in ('draft', 'confirmed')"/>
                        </group>
                        <group string="Schedule">
                            <field name="doctor_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="department_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="appointment_date" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="duration" widget="float_time" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="consultation_fee" readonly="invoice_id"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="symptoms" placeholder="Describe the symptoms..."/>
                        <field name="notes" placeholder="Internal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_clinic_appointment_calendar" model="ir.ui.view">
        <field name="name">clinic.appointment.calendar</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="appointment_date" date_stop="end_datetime" color="doctor_id"
                      mode="week" event_open_popup="1" quick_create="0">
                <field name="patient_id"/>
                <field name="doctor_id" filters="1"/>
                <field name="appointment_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_clinic_appointment_kanban" model="ir.ui.view">
        <field name="name">clinic.appointment.kanban</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="0" group_delete="0" records_draggable="0">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <field name="patient_id" class="fs-5"/>
                        <div class="text-muted"><i title="Doctor" class="fa fa-user-md me-1"/><field name="doctor_id"/></div>
                        <div><i title="Time" class="fa fa-clock-o me-1"/><field name="appointment_date"/></div>
                        <footer>
                            <field name="appointment_type" class="badge text-bg-light"/>
                            <field name="consultation_fee" widget="monetary" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_clinic_appointment_search" model="ir.ui.view">
        <field name="name">clinic.appointment.search</field>
        <field name="model">clinic.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="department_id"/>
                <filter name="today" string="Today"
                        domain="[('appointment_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')),
                                 ('appointment_date', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="upcoming" string="Upcoming" domain="[('appointment_date', '&gt;=', datetime.datetime.now().to_utc().strftime('%Y-%m-%d %H:%M:%S')), ('state', 'in', ('draft', 'confirmed'))]"/>
                <filter name="filter_date" string="Date" date="appointment_date"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_clinic" string="In Clinic" domain="[('state', 'in', ('checked_in', 'in_consultation'))]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled / No Show" domain="[('state', 'in', ('cancelled', 'no_show'))]"/>
                <separator/>
                <filter name="emergency" string="Emergency" domain="[('appointment_type', '=', 'emergency')]"/>
                <filter name="not_invoiced" string="Not Invoiced" domain="[('invoice_id', '=', False), ('state', 'in', ('checked_in', 'in_consultation', 'done'))]"/>
                <group>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'appointment_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'appointment_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clinic_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">list,calendar,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book your first appointment</p>
            <p>Draft → Confirmed → Checked In → In Consultation → Completed. Double bookings for a doctor are blocked automatically.</p>
        </field>
    </record>

    <record id="action_clinic_appointment_today" model="ir.actions.act_window">
        <field name="name">Today's Appointments</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
</odoo>
