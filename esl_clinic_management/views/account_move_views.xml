<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_clinic" model="ir.ui.view">
        <field name="name">account.move.form.clinic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="clinic_patient_id" invisible="not clinic_patient_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_clinic" model="ir.ui.view">
        <field name="name">account.move.search.clinic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="clinic_patient_id"/>
                <filter name="clinic_outstanding" string="Outstanding" domain="[('state', '=', 'posted'), ('amount_residual', '&gt;', 0)]"/>
                <filter name="group_clinic_patient" string="Patient" context="{'group_by': 'clinic_patient_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_clinic_invoice" model="ir.actions.act_window">
        <field name="name">Patient Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('clinic_patient_id', '!=', False), ('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No patient invoices yet</p>
            <p>Invoices are created from appointments, admissions, prescriptions and lab requests, then paid with the standard Register Payment flow.</p>
        </field>
    </record>

    <record id="action_clinic_outstanding" model="ir.actions.act_window">
        <field name="name">Outstanding Payments</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('clinic_patient_id', '!=', False), ('move_type', '=', 'out_invoice'), ('state', '=', 'posted'), ('amount_residual', '&gt;', 0)]</field>
        <field name="context">{'create': False, 'search_default_group_clinic_patient': 1}</field>
    </record>

    <record id="action_clinic_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'customer'), ('invoice_ids.clinic_patient_id', '!=', False)]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_partner_type': 'customer', 'create': False}</field>
    </record>
</odoo>
