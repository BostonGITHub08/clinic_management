<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_clinic" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.clinic</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Clinic" string="Clinic" name="clinic_management" groups="clinic_management.group_clinic_manager">
                    <block title="Appointments" name="clinic_appointment_settings">
                        <setting string="Default Duration" help="Default length of a new appointment">
                            <field name="clinic_appointment_duration" widget="float_time"/>
                        </setting>
                        <setting help="Block appointments outside the doctor's available days and working hours">
                            <field name="clinic_check_doctor_availability"/>
                        </setting>
                    </block>
                    <block title="Billing" name="clinic_billing_settings">
                        <setting string="Admission Fee" help="One-time fee added to every admission invoice">
                            <field name="clinic_admission_fee"/>
                        </setting>
                        <setting string="Billing Products" help="Products used on invoice lines (they define income accounts and taxes)">
                            <div class="mt-2">
                                <div class="row"><label for="clinic_consultation_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="clinic_consultation_product_id" placeholder="Consultation Fee"/></div>
                                <div class="row"><label for="clinic_admission_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="clinic_admission_product_id" placeholder="Admission Charges"/></div>
                                <div class="row"><label for="clinic_bed_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="clinic_bed_product_id" placeholder="Room &amp; Bed Charges"/></div>
                                <div class="row"><label for="clinic_lab_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="clinic_lab_product_id" placeholder="Laboratory Charges"/></div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_clinic_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'clinic_management', 'bin_size': False}</field>
    </record>
</odoo>
