<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_clinic" model="ir.module.category">
        <field name="name">Clinic</field>
        <field name="sequence">15</field>
    </record>

    <!-- One privilege per role so a user can hold several roles (e.g. Nurse + Pharmacist) -->
    <record id="privilege_clinic_front_desk" model="res.groups.privilege">
        <field name="name">Front Desk</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>
    <record id="privilege_clinic_nursing" model="res.groups.privilege">
        <field name="name">Nursing</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>
    <record id="privilege_clinic_laboratory" model="res.groups.privilege">
        <field name="name">Laboratory</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>
    <record id="privilege_clinic_pharmacy" model="res.groups.privilege">
        <field name="name">Pharmacy</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>
    <record id="privilege_clinic_medical" model="res.groups.privilege">
        <field name="name">Clinic</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_clinic"/>
    </record>

    <!-- base group: read access and menu visibility, implied by every role -->
    <record id="group_clinic_user" model="res.groups">
        <field name="name">Clinic: Basic Access</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_clinic_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_clinic_front_desk"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_clinic_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_clinic_nursing"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_user'))]"/>
    </record>
    <record id="group_clinic_lab" model="res.groups">
        <field name="name">Laboratory Technician</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_clinic_laboratory"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_user'))]"/>
    </record>
    <record id="group_clinic_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_clinic_pharmacy"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_user')), (4, ref('stock.group_stock_user')), (4, ref('account.group_account_invoice'))]"/>
    </record>
    <record id="group_clinic_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_clinic_medical"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_user'))]"/>
    </record>
    <record id="group_clinic_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_clinic_medical"/>
        <field name="implied_ids" eval="[(4, ref('group_clinic_doctor')), (4, ref('group_clinic_receptionist')),
                                         (4, ref('group_clinic_nurse')), (4, ref('group_clinic_lab')),
                                         (4, ref('group_clinic_pharmacist'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- multi-company record rules -->
    <record id="rule_clinic_patient_company" model="ir.rule">
        <field name="name">Clinic Patient: multi-company</field>
        <field name="model_id" ref="model_clinic_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_clinic_doctor_company" model="ir.rule">
        <field name="name">Clinic Doctor: multi-company</field>
        <field name="model_id" ref="model_clinic_doctor"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_staff_company" model="ir.rule">
        <field name="name">Clinic Staff: multi-company</field>
        <field name="model_id" ref="model_clinic_staff"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_department_company" model="ir.rule">
        <field name="name">Clinic Department: multi-company</field>
        <field name="model_id" ref="model_clinic_department"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>
    <record id="rule_clinic_appointment_company" model="ir.rule">
        <field name="name">Clinic Appointment: multi-company</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_consultation_company" model="ir.rule">
        <field name="name">Clinic Consultation: multi-company</field>
        <field name="model_id" ref="model_clinic_consultation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_room_category_company" model="ir.rule">
        <field name="name">Clinic Room Category: multi-company</field>
        <field name="model_id" ref="model_clinic_room_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_room_company" model="ir.rule">
        <field name="name">Clinic Room: multi-company</field>
        <field name="model_id" ref="model_clinic_room"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_bed_company" model="ir.rule">
        <field name="name">Clinic Bed: multi-company</field>
        <field name="model_id" ref="model_clinic_bed"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_admission_company" model="ir.rule">
        <field name="name">Clinic Admission: multi-company</field>
        <field name="model_id" ref="model_clinic_admission"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_discharge_company" model="ir.rule">
        <field name="name">Clinic Discharge: multi-company</field>
        <field name="model_id" ref="model_clinic_discharge"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_prescription_company" model="ir.rule">
        <field name="name">Clinic Prescription: multi-company</field>
        <field name="model_id" ref="model_clinic_prescription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_clinic_lab_request_company" model="ir.rule">
        <field name="name">Clinic Lab Request: multi-company</field>
        <field name="model_id" ref="model_clinic_lab_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
